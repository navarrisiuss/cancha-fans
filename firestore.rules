// Copia de referencia de las security rules de Firestore. Las rules vigentes se publican a mano en
// la consola de Firebase (Firestore → Reglas); si cambias este archivo, publícalo allí también.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada quien lee y escribe solo su propio documento. isAdmin no se puede activar desde el
    // cliente: se cambia a mano en la consola, que no pasa por estas rules.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'phone', 'photoURL', 'isAdmin', 'createdAt'])
        && request.resource.data.isAdmin == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'phone', 'photoURL']);

      allow delete: if false;
    }

    // Lee isAdmin del documento del usuario. Cada llamada cuenta como 1 lectura; solo se evalúa
    // cuando las condiciones anteriores del || no alcanzan.
    function esAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Lectura pública solo si el admin lo aprobó; el dueño y el admin leen siempre. Se crea siempre
    // en revisión y con los contadores en cero: nadie puede publicarse a sí mismo. Sin edición ni
    // borrado hasta que existan esas funcionalidades (la aprobación del admin va por Admin SDK).
    match /complejos/{complejoId} {
      allow read: if resource.data.estado == 'aprobado'
        || (request.auth != null && resource.data.ownerId == request.auth.uid)
        || esAdmin();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['ownerId', 'nombre', 'descripcion', 'region', 'comuna', 'direccion', 'fotos',
              'estado', 'formatosDisponibles', 'ratingPromedio', 'totalResenas',
              'createdAt', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.estado == 'en_revision'
        && request.resource.data.nombre is string
        && request.resource.data.descripcion is string
        && request.resource.data.region is string
        && request.resource.data.comuna is string
        && request.resource.data.direccion is string
        && request.resource.data.fotos is list
        && request.resource.data.fotos.size() <= 5
        && request.resource.data.formatosDisponibles == []
        && request.resource.data.ratingPromedio == 0
        && request.resource.data.totalResenas == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;

      // Datos legales del complejo: nunca públicos, ni siquiera con el complejo aprobado.
      match /privado/{documento} {
        allow read: if request.auth != null
          && (resource.data.ownerId == request.auth.uid || esAdmin());

        // getAfter ve el complejo que se crea en el mismo batch: evita que alguien ocupe el
        // documento privado de un complejo ajeno.
        allow create: if request.auth != null
          && documento == 'datos'
          && request.resource.data.keys().hasOnly(['ownerId', 'rut', 'razonSocial', 'datosBancarios'])
          && request.resource.data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/complejos/$(complejoId)).data.ownerId
               == request.auth.uid;

        allow update, delete: if false;
      }

      // Lectura pública solo si el complejo está aprobado; el dueño y el admin leen siempre. Sin
      // escritura desde el cliente: cada cambio de una cancha también actualiza formatosDisponibles
      // del complejo, y eso lo hace un Route Handler con el Admin SDK, que se salta estas rules.
      match /canchas/{canchaId} {
        allow read: if get(/databases/$(database)/documents/complejos/$(complejoId)).data.estado == 'aprobado'
          || (request.auth != null
              && get(/databases/$(database)/documents/complejos/$(complejoId)).data.ownerId
                   == request.auth.uid)
          || esAdmin();

        allow write: if false;
      }
    }

    // Lo lee el jugador que reservó, el dueño del complejo y el admin. Nadie escribe desde el
    // cliente: crear la reserva, pagarla y cancelarla pasan siempre por Route Handlers con el
    // Admin SDK. Las consultas del cliente deben filtrar por jugadorId u ownerId igual al uid
    // propio, si no la rule las rechaza.
    match /reservas/{reservaId} {
      allow read: if request.auth != null
        && (resource.data.jugadorId == request.auth.uid
            || resource.data.ownerId == request.auth.uid
            || esAdmin());

      allow write: if false;
    }

    // Bloqueos manuales: solo los ve su dueño (y el admin). La disponibilidad los cruza en el
    // servidor, así que el jugador nunca necesita leerlos. Se escriben por Route Handler, que
    // además rechaza el bloqueo si choca con una reserva activa.
    match /bloqueos/{bloqueoId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || esAdmin());

      allow write: if false;
    }

    // Las reseñas se muestran en la ficha pública, así que se leen sin sesión. Se crean por Route
    // Handler: la misma transacción actualiza ratingPromedio y totalResenas del complejo, y esos
    // campos no se pueden escribir desde el cliente. Sin edición ni borrado.
    match /resenas/{resenaId} {
      allow read: if true;
      allow write: if false;
    }

    // Cada usuario lee solo las suyas y solo puede marcarlas como leídas. Se crean únicamente desde
    // el servidor, en la misma operación que las origina. Las consultas del cliente (lista y
    // count() de no leídas) deben filtrar por userId igual al uid propio.
    match /notificaciones/{notificacionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
        && request.resource.data.leida is bool;

      allow create, delete: if false;
    }
  }
}
