# Configuración web del proyecto de Firebase (consola → Configuración del proyecto → Tus apps).
# Copia este archivo a .env.local y rellena los valores. .env.local no se sube al repo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK (solo servidor). Sin NEXT_PUBLIC_: nunca llegan al navegador.
# Consola → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Copia client_email y private_key del JSON descargado (el JSON nunca se sube al repo).
# La clave va en una sola línea, entre comillas y con los \n tal como vienen en el JSON.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# URL pública de la app, sin barra final. Webpay vuelve a ${NEXT_PUBLIC_APP_URL}/api/pagos/retorno y
# los correos enlazan a ella. En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correos con Resend (solo servidor). La clave sale de resend.com → API Keys.
# Sin dominio verificado, Resend solo envía al correo dueño de la cuenta: sirve para probar.
# RESEND_FROM es el remitente; para pruebas sirve "CanchaFans <onboarding@resend.dev>".
RESEND_API_KEY=
RESEND_FROM=CanchaFans <onboarding@resend.dev>

# Emuladores (opcional)
# Copia y descomenta estas variables en .env.development.local para mantenerlas
# separadas de la configuración de Firebase real.
# NEXT_PUBLIC_USAR_EMULADORES=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cancha-fans
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
